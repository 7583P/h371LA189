<?xml version="1.0" encoding="UTF-8"?>
<dependencies>
  <!-- Billing 9 resolves kotlin-stdlib 1.8.22 while the Games v2 coroutine graph still
       requests the pre-merge jdk7/jdk8 1.6.21 artifacts. Directly aligning those two
       compatibility artifacts prevents duplicate Kotlin classes on AGP 8.10. -->
  <androidPackages>
    <androidPackage spec="org.jetbrains.kotlin:kotlin-stdlib-jdk7:1.8.22">
      <repositories>
        <repository>https://repo.maven.apache.org/maven2/</repository>
      </repositories>
    </androidPackage>
    <androidPackage spec="org.jetbrains.kotlin:kotlin-stdlib-jdk8:1.8.22">
      <repositories>
        <repository>https://repo.maven.apache.org/maven2/</repository>
      </repositories>
    </androidPackage>
  </androidPackages>
</dependencies>
